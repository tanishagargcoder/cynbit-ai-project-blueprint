# All variables are optional. The app works fully without any of them.

# Where new leads are forwarded (Slack/Discord incoming webhook, or a Google Apps Script URL).
# If unset, leads are only logged to the server console.
LEAD_WEBHOOK_URL=

# Optional free-tier LLM that rewrites the one-paragraph summary in a friendlier voice.
# Get a free key at https://aistudio.google.com/apikey . If unset or the call fails,
# the deterministic summary is used instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
